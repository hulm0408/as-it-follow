# ==============================================================================
# TOING TELEGRAM BOT CONFIGURATION
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated list of Telegram User IDs authorized to use the bot
# Leave empty to allow any user to access
ALLOWED_USER_IDS=6484999726,123456789

# Telegram ID of the administrator/owner (fallback if ALLOWED_USER_IDS is empty)
BOSS_ID=6484999726

# Directory for persistent data storage (state.json)
# Default on Render: /app/data
# Default locally: ./data
DATA_DIR=./data

# Secret key for encrypting stored Swiggy credentials at rest in state.json
# If unset, falls back to BOT_TOKEN derived key
PERSISTENCE_SECRET=your-random-32-character-secret-salt-here

# Optional: Port for web health checks (e.g. 10000 on Render Web Service)
# Leave unset when running as a Render background worker
# PORT=10000

# Headless mode for Puppeteer WAF & QR generation (default: true)
HEADLESS=true

# Puppeteer executable path for Linux/Render environments
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
